+// lamaria-slam: optional CLAHE on grayscale input, OKVIS_CLAHE=<clip limit> (8x8 tiles)
+static void lamariaClahe(cv::Mat& img) {
+  static const char* env = std::getenv("OKVIS_CLAHE");
+  static bool announced = false;
+  if (!announced) {
+    announced = true;
+    std::cerr << "OKVIS_CLAHE: " << ((env && *env) ? env : "off") << std::endl;
+  }
+  if (env && *env && img.type() == CV_8UC1) {
+    cv::Ptr<cv::CLAHE> clahe = cv::createCLAHE(std::atof(env), cv::Size(8, 8));
+    clahe->apply(img, img);
+  }
+}
